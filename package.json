{
  "name": "direnv-action",
  "version": "1.4.9",
  "description": "Provides environment variables via direnv",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "eslint index.js index.test.js dependency-compat.test.js scripts/*.js",
    "prepare": "patch-package --error-on-fail && ncc build index.js -o dist --source-map && node scripts/normalize-dist.js",
    "test": "vitest run",
    "all": "npm run lint && npm run prepare && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HatsuneMiku3939/direnv-action.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "JavaScript"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/HatsuneMiku3939/direnv-action/issues"
  },
  "homepage": "https://github.com/HatsuneMiku3939/direnv-action#readme",
  "dependencies": {
    "@actions/cache": "^6.3.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vercel/ncc": "^0.45.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "patch-package": "8.0.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch@^10.2.5": "11.0.3",
    "@actions/glob": "0.7.0"
  }
}
